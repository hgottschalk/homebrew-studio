# ==============================================================================
# Homebrew Recipe Studio — Open-Source Environment Configuration (.env.example)
# Copy this file to .env.local for local development or add to Vercel Settings.
# All variables are OPTIONAL. The app works out of the box with zero config!
# ==============================================================================

# 1. Optional Brewery PIN / Passcode Lock
# Leave blank for open local access. Set a PIN or passphrase (e.g. 4829) when
# deploying to a public URL (like Vercel) to require a 90-day login cookie.
BREW_STUDIO_PIN=

# 2. Optional $0 Cloud Sync — Option A: Secret GitHub Gist (100% Free Forever)
# Create a GitHub Personal Access Token with ONLY the "gist" scope at:
# https://github.com/settings/tokens
# The app will automatically create & sync `homebrew-recipe-studio-state.json`
# in a private Gist across your computer and phone!
GITHUB_GIST_TOKEN=
GITHUB_GIST_ID=

# 3. Optional $0 Cloud Sync — Option B: Upstash Redis / Vercel KV (Free Tier)
# Connect Upstash Redis in the Vercel Marketplace (or https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 4. Optional Gemini API Key for Live AI Brewmaster Cloud Reasoning
# If omitted, the AI Brewmaster tab uses its built-in offline Brewmaster engine.
GEMINI_API_KEY=
